{
  "name": "turkish-inflect",
  "version": "0.1.5",
  "description": "Turkish noun and verb inflection: vowel harmony, consonant mutation, and case/tense suffixes.",
  "keywords": [
    "turkish",
    "türkçe",
    "inflection",
    "çekim",
    "morphology",
    "biçimbilim",
    "linguistics",
    "dilbilim",
    "vowel-harmony",
    "ünlü-uyumu",
    "grammar",
    "dilbilgisi",
    "nlp",
    "turkish-nlp"
  ],
  "homepage": "https://github.com/f-gee/turkish-inflect#readme",
  "bugs": {
    "url": "https://github.com/f-gee/turkish-inflect/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f-gee/turkish-inflect.git"
  },
  "license": "MIT",
  "author": "F Gee",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "eslint": "^9.0.0"
  }
}
